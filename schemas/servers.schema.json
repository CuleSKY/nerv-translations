{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "servers/<community>.json",
  "description": "The server naming rules of one community, <community> being its ID in NERV's global settings, in the translation repository CuleSKY/nerv-translations. The site takes a merged version only when every file passes this schema and the checks it cannot express: variables, duplicate rules and addresses.",
  "$ref": "#/$defs/NamingFile",
  "$defs": {
    "NamedServer": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "The server's connect address as the site shows it",
          "maxLength": 259,
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])){3}|(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?):(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})$",
          "type": "string"
        },
        "names": {
          "additionalProperties": false,
          "description": "The names by language: en, zh-CN, ja, ko. A language left out shows the original name; zh-Hant is converted from zh-CN",
          "minProperties": 1,
          "properties": {
            "en": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "ja": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "ko": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "zh-CN": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "address",
        "names"
      ],
      "type": "object"
    },
    "NamingFile": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "description": "The naming rules; the first whose match is a server's whole original name gives its names",
          "items": {
            "$ref": "#/$defs/NamingRule"
          },
          "maxItems": 500,
          "type": "array"
        },
        "servers": {
          "description": "Names of single servers by their address; they come before the rules",
          "items": {
            "$ref": "#/$defs/NamedServer"
          },
          "maxItems": 1000,
          "type": "array"
        }
      },
      "type": "object"
    },
    "NamingRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "description": "A whole original name, compared exactly, in which {variable} stands for text that varies (at least one character); {{ and }} are literal braces",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "names": {
          "additionalProperties": false,
          "description": "The names by language: en, zh-CN, ja, ko. A language left out shows the original name; zh-Hant is converted from zh-CN",
          "minProperties": 1,
          "properties": {
            "en": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "ja": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "ko": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "zh-CN": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "match",
        "names"
      ],
      "type": "object"
    }
  }
}
